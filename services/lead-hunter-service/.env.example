# HTTP port (default inside app: 3847)
PORT=3847

# Telegram (GramJS) — https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Строка сессии после `npm run build` и `npm run telegram:login`
TELEGRAM_SESSION=

# Поиск публичных чатов/каналов (через запятую, точку с запятой или перевод строки)
TELEGRAM_DISCOVERY_QUERIES=
# Макс. уникальных чатов на один запрос (1–100)
TELEGRAM_DISCOVERY_LIMIT=20
# true — после discovery пытаться вступить в публичные каналы/супергруппы; false — только skipped
TELEGRAM_AUTO_JOIN=false
