# Caddy конфигурация для lek7.com
# Автоматически получает SSL сертификаты через Let's Encrypt
# app:3000 — сервис app из docker-compose (Caddy и app в одной сети)

lek7.com {
    reverse_proxy app:3000
}

www.lek7.com {
    reverse_proxy app:3000
}

# Если нужен кастомный домен для файлов (опционально)
# files.lec7.com {
#     reverse_proxy <R2_PUBLIC_DOMAIN>
# }
